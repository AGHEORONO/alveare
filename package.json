{
  "name": "alveare",
  "version": "0.3.0",
  "description": "Alveare: a local-first hive where a team of AI coding agents (Claude Code, Cursor, Gemini, Codex, Copilot…) split work, avoid conflicts and talk to each other on one repo",
  "type": "module",
  "bin": {
    "alveare": "dist/cli.js",
    "hive": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p .",
    "prepare": "tsc -p .",
    "host": "node dist/cli.js host",
    "join": "node dist/cli.js join",
    "test": "node --import tsx --test test/*.test.ts",
    "sim": "tsx scripts/simulate.ts",
    "build:exe": "node scripts/build-sea.mjs",
    "typecheck": "tsc -p . --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "bonjour-service": "^1.4.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "public",
    "client",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AGHEORONO/alveare.git"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "ai-agents",
    "multi-agent",
    "hackathon",
    "collaboration"
  ]
}
